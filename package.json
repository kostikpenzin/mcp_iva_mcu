{
  "name": "mcp-iva-mcu",
  "version": "1.5.0",
  "description": "MCP server for IVA MCU video conferencing platform",
  "license": "MIT",
  "mcpName": "io.github.kostikpenzin/mcp-iva-mcu",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-iva-mcu": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "i18n/README.ru.md"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "modelcontextprotocol",
    "mcp",
    "mcp-server",
    "iva",
    "mcu",
    "video-conferencing",
    "iva-mcu",
    "claude",
    "claude-desktop",
    "openapi",
    "rest-api",
    "webrtc",
    "bot-api",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kostikpenzin/mcp_iva_mcu.git"
  },
  "bugs": {
    "url": "https://github.com/kostikpenzin/mcp_iva_mcu/issues"
  },
  "homepage": "https://github.com/kostikpenzin/mcp_iva_mcu#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "rimraf": "^6.0.0",
    "shx": "^0.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
